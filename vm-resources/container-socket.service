[Unit]
Description=Console socket for the crun/runc container lifecycle tests
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
# Installed as a systemd *user* unit by playbook.yaml, so %h resolves to the
# home of whoever provisioned the machine - no user name is hardcoded here.
ExecStartPre=-/bin/rm -f %h/code/fwilhe-containers/container-image/mySocket.sock
ExecStart=/usr/bin/nc -lkU %h/code/fwilhe-containers/container-image/mySocket.sock

[Install]
WantedBy=default.target
